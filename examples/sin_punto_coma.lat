// Declaracion de variable tipo estructura SIN ';' final.
VARIABILES>

structura Animal {
    esto nombre : textum;
    esto apodo : textum;
} finis;

structura Selva {
    esto valido : verum;
    series animales : Animal;
} finis;

esto mi_selva: Selva { valido: verum, animales: Animal[7] }

MAIOR>

>> mi_selva.valido;

FINIS;

VARIABILES>

esto edad : numerus 20;
esto # : numerus 1;             // simbolo no reconocido
esto saludo : textum "sin cerrar;
esto inicial : littera 'a;

MAIOR>

>> edad;

/* este comentario nunca cierra
FINIS;
